<h4>Toxic Terminal</h4>

<div style="background:black; color:lime; font-family:monospace; height:400px; overflow-y:auto; padding:10px;">
    @foreach (var line in Output)
    {
        <div>@line</div>
    }
</div>

<input @bind="Command" @bind:event="oninput" @onkeydown="HandleEnter" placeholder="Type command..." style="width:100%;" />

@code {
    private List<string> Output = new();
    private string Command = "";
    ToxicService toxicService;

    protected override void OnInitialized()
    {
        toxicService = new ToxicService();
        toxicService.OnOutput += line =>
        {
            InvokeAsync(() =>
            {
                Output.Add(line);
                StateHasChanged();
            });
        };
        toxicService.Start();
    }

    private void HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(Command))
        {
            toxicService.SendCommand(Command);
            Command = "";
        }
    }
}
