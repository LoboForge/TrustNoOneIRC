@using LoboForge.TNOIRC.Services
@using LoboForge.TNOIRC.Shared.Models
@using global::BotCore.Interfaces
@using LoboForge.TNOIRC.BotEngine
@implements IDisposable

<div class="container mt-3">
    <h4>IRC Bot Manager</h4>
    <div class="mb-3">
        <label for="botPath">Bot Folder Override:</label>
        <input id="botPath" class="form-control form-control-sm" @bind="BotFolderOverride" placeholder="e.g. C:\MyBots or ./Bots" />
    </div>
    <div class="mb-3 d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-outline-primary" @onclick="ReloadBots">🔄 Reload Bots</button>
    </div>

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Status</th>
                <th>Actions</th>
                <th>Logs</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bot in Bots)
            {
                <tr>
                    <td>@bot.Name</td>
                    <td>@bot.SourceType</td>
                    <td>@(bot.Enabled ? "✅ Enabled" : "❌ Disabled")</td>
                    <td>
                        <button class="btn btn-sm btn-success me-2"
                                @onclick="() => StartBot(bot)"
                                disabled="@bot.Enabled">
                            Start
                        </button>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => StopBot(bot)"
                                disabled="@(!bot.Enabled)">
                            Stop
                        </button>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-secondary"
                                @onclick="() => ShowLogsForBot(bot)">
                            Logs
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Errors.Any())
    {
        <div class="alert alert-danger mt-3">
            <strong>Compilation Errors:</strong>
            <ul>
                @foreach (var err in Errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (SelectedBotForLogs != null)
    {
        <div style="max-height: 350px; overflow-y: auto; background-color: #111; padding: 1rem; color: #ffcc00; font-family: monospace; margin-bottom: 2rem;">
            <strong>@SelectedBotForLogs.Name Bot Logs:</strong>
            <ul>
                @if ((SelectedBotForLogs.Instance as LoboForge.TNOIRC.BotCore.Models.BotBase)?.Logs?.Any() == true)
                {
                    @foreach (var log in ((LoboForge.TNOIRC.BotCore.Models.BotBase)SelectedBotForLogs.Instance).Logs)
                    {
                        <li>@log</li>
                    }
                }
                else
                {
                    <li>No logs yet.</li>
                }
            </ul>
            <button class="btn btn-sm btn-outline-warning mt-2" @onclick="() => SelectedBotForLogs = null">Close Logs</button>
        </div>
    }
</div>

@code {
    private List<IBotMetadata> Bots = new();
    private List<string> Errors = new();
    private PluginService PluginService = new();
    private IBotMetadata? SelectedBotForLogs;
    private string BotFolderOverride = "D:\\Development\\TrustNoOneIRC\\GhostRootBot";
    private bool eventsSubscribed = false;

    protected override void OnInitialized()
    {
        LoadBots();
    }

    private void LoadBots()
    {
        // Load both types
        var codBots = PluginService.ReloadBots(BotFolderOverride);
        var dllBots = PluginService.ReloadBots();

        // Optionally: avoid duplicates (e.g. if you have same bot name/type in both)
        var allBots = codBots.Bots.Concat(dllBots.Bots)
            .GroupBy(b => b.Name)
            .Select(g => g.First())
            .ToList();
        allBots.AddRange(BotService.BotsMeta);
        Bots = allBots;
        Errors = codBots.Errors.Concat(dllBots.Errors).ToList();
        SelectedBotForLogs = null;
        SubscribeBotEvents();
        StateHasChanged();
    }

    private void ReloadBots() => LoadBots();

    private void StartBot(IBotMetadata bot)
    {
        if (!bot.Enabled)
        {
            bot.Enabled = true;
            bot.Instance?.OnStart();
        }
    }

    private void StopBot(IBotMetadata bot)
    {
        if (bot.Enabled)
        {
            bot.Enabled = false;
            bot.Instance?.OnStop();
        }
    }

    private void ShowLogsForBot(IBotMetadata bot)
    {
        SelectedBotForLogs = bot;
        StateHasChanged();
    }

    private void SubscribeBotEvents()
    {
        if (eventsSubscribed) return;
        eventsSubscribed = true;

        EventBus.Subscribe<BotPrivateMessageEvent>(evt =>
        {
            Common.ircClient.SendRawAsync($"PRIVMSG {evt.Nick} :{evt.Message}");
        });
        EventBus.Subscribe<BotSendChannelMessageEvent>(evt =>
        {
            Common.ircClient.SendRawAsync($"PRIVMSG {evt.Channel} :{evt.Message}");
        });
    }

    public void Dispose()
    {
        // TODO: Add EventBus.Unsubscribe if you store the delegates for removal
    }
}
