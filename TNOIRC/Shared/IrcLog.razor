@using LoboForge.TNOIRC
@implements IDisposable

<div class="irc-log">
    @foreach (var message in Messages)
    {
        <div class="log-line">@message</div>
    }
</div>

@code {
    private List<string> Messages { get; set; } = new();
    private Action<ServerMessage>? _messageHandler;

    protected override void OnInitialized()
    {
        Messages = Common.ircClient?.ServerMessages.ToList() ?? new List<string>();
        _messageHandler = HandleMessage;
        EventBus.Subscribe<ServerMessage>(_messageHandler);
    }

    private void HandleMessage(ServerMessage message)
    {
        Messages = Common.ircClient?.ServerMessages.ToList() ?? new List<string>();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_messageHandler != null)
            EventBus.Unsubscribe<ServerMessage>(_messageHandler);
    }
}
