@using LoboForge.TNOIRC.Models
@inject IMyWhoisService WhoisService

<div style="min-width:350px; min-height:180px; color:#0f0;">
    <h4>IP Whois: @User?.Nick</h4>
    @if (User == null)
    {
        <div>User info missing.</div>
    }
    else if (IsCloaked)
    {
        <div>User is cloaked or not using a direct IP. No lookup possible.</div>
    }
    else if (LookupInProgress)
    {
        <div>Loading...</div>
    }
    else if (LookupResult != null)
    {
        <div>
            <b>IP:</b> @LookupResult.IP<br>
            <b>Country:</b> @LookupResult.Country<br>
            <b>Org:</b> @LookupResult.Org<br>
            <b>ASN:</b> @LookupResult.ASN<br>
            <b>Threat/Blacklist:</b> @LookupResult.ThreatInfo<br>
            <!-- Add any other fields -->
        </div>
    }
    else
    {
        <div>Failed to retrieve IP info.</div>
    }
</div>

@code {
    [Parameter] public IrcUser? User { get; set; }

    private IpWhoisResult? LookupResult;
    private bool LookupInProgress = false;
    private bool IsCloaked => User == null || !User.HostIsIP();

    protected override async Task OnInitializedAsync()
    {
        if (User == null || IsCloaked)
            return;

        LookupInProgress = true;
        LookupResult = await WhoisService.LookupAsync(User.Host);
        LookupInProgress = false;
        StateHasChanged();
    }
}
