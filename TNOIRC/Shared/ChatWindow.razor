@using LoboForge.TNOIRC
@using LoboForge.TNOIRC.Models
@using LoboForge.TNOIRC.Shared
@implements IDisposable
@inject IJSRuntime JSRuntime

@if (Channel is null)
{
    <div class="chat-window-content">No channel loaded.</div>
}
else
{
    <div class="chat-window-content d-flex flex-column">
        <div class="flex-grow-1 d-flex overflow-hidden">
            @if (ShowUserList)
            {
                <div class="user-list">
                    @foreach (var user in Channel.Users.OrderBy(u => u.Nick))
                    {
                        <div class="user-entry" @onclick="() => StartPm(user)">
                            @user.Nick
                            @if (user.HostIsIP())
                            {
                                <span title="Lookup IP" style="cursor:pointer; margin-left:6px;"
                                      @onclick:stopPropagation
                                      @onclick="() => RaiseIpLookup(user)">
                                    🔍
                                </span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="chat-messages flex-grow-1 overflow-auto" @ref="MessagesDiv">
                @foreach (var msg in Channel.Messages)
                {
                    if (msg.IsNotice)
                    {
                        <div class="chat-message notice-msg">
                            <span class="timestamp">[@msg.Timestamp.ToShortTimeString()]</span>
                            <span class="user notice">*** @msg.Content ***</span>
                        </div>
                    }
                    else if (!msg.IsAction)
                    {
                        <div class="chat-message">
                            <span class="timestamp">[@msg.Timestamp.ToShortTimeString()]</span>
                            <span class="user">@msg.Sender.Nick:</span>
                            <span class="text">
                                @foreach (var line in msg.Content.Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.None))
                                {
                                    @line
                                    <br />
                                }
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="chat-message">
                            <span class="timestamp">[@msg.Timestamp.ToShortTimeString()]</span>
                            <span class="user" style="font-weight:bold;">** @msg.Sender.Nick @msg.Content **</span>
                        </div>
                    }
                }
            </div>
        </div>
        <div style="position:absolute; bottom:50px; left:10px; width:90%; background-color:transparent;">
            <button @onclick="ToggleUserList">👥</button>
        </div>
        <div class="chat-input mt-1">
            <input type="text"
                   @bind-value="CurrentMessage"
                   @bind-value:event="oninput"
                   @onkeydown="HandleKey"
                   placeholder="Type your message..."
                   disabled="@(!Common.IsConnected)" />
            <button @onclick="SendMessage" disabled="@(!Common.IsConnected)">Send</button>
        </div>
    </div>
}

@code {
    [Parameter] public IrcChannel Channel { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private string CurrentMessage = "";
    private ElementReference MessagesDiv;
    private bool ShowUserList = true;

    private Action<ChannelMessageReceivedEvent>? _messageHandler;
    private Action<UserJoinedEvent>? _joinHandler;

    protected override void OnInitialized()
    {
        _messageHandler = HandleNewMessage;
        _joinHandler = HandleUserJoined;
        EventBus.Subscribe<ChannelMessageReceivedEvent>(_messageHandler);
        EventBus.Subscribe<UserJoinedEvent>(_joinHandler);
    }

    private async void HandleUserJoined(UserJoinedEvent evt)
    {
        if (!string.Equals(evt.Channel, Channel.Name, StringComparison.OrdinalIgnoreCase))
            return;

        await InvokeAsync(StateHasChanged);
    }

    private void RaiseIpLookup(IrcUser user)
    {
        EventBus.Publish(new UserIpLookupRequestedEvent(user, Channel.Name));
    }

    private void StartPm(IrcUser user)
    {
        EventBus.Publish(new RequestPrivateMessageEvent(user));
    }

    private void ToggleUserList()
    {
        ShowUserList = !ShowUserList;
    }

    private async void HandleNewMessage(ChannelMessageReceivedEvent evt)
    {
        if (!string.Equals(evt.Target, Channel.Name, StringComparison.OrdinalIgnoreCase))
            return;

        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Delay(50);
            await ScrollToBottom();
        });
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Channel.LastChecked = DateTime.UtcNow;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ScrollToBottom();
    }

    private async Task SendMessage()
    {
        if (!Common.IsConnected || string.IsNullOrWhiteSpace(CurrentMessage))
            return;

        await Common.ircClient.SendMessageAsync(Channel.Name, CurrentMessage);
        CurrentMessage = "";
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("scrollToBottom", MessagesDiv);
    }

    public void Dispose()
    {
        if (_messageHandler != null)
            EventBus.Unsubscribe<ChannelMessageReceivedEvent>(_messageHandler);
        if (_joinHandler != null)
            EventBus.Unsubscribe<UserJoinedEvent>(_joinHandler);
    }
}
