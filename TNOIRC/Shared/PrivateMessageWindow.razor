@using LoboForge.TNOIRC
@using LoboForge.TNOIRC.Models
@using LoboForge.TNOIRC.Shared
@implements IDisposable
@inject IJSRuntime JSRuntime

@if (Conversation is null)
{
    <div class="pm-window-content">No conversation loaded.</div>
}
else
{
    <div class="private-message-window d-flex flex-column">
        <div class="pm-messages flex-grow-1 overflow-auto" @ref="MessagesDiv">
            @foreach (var msg in Conversation.Messages)
            {
                <div class="pm-message">
                    <span class="timestamp">[@msg.Timestamp.ToShortTimeString()]</span>
                    <span class="user">@msg.Sender.Nick:</span>
                    <span class="text">@msg.Content</span>
                </div>
            }
        </div>

        <div class="chat-input mt-1">
            <input type="text"
                   @bind-value="CurrentMessage"
                   @bind-value:event="oninput"
                   @onkeydown="HandleKey"
                   placeholder="Type your message..."
                   disabled="@(!Common.IsConnected)" />
            <button @onclick="SendMessage" disabled="@(!Common.IsConnected)">Send</button>
        </div>
    </div>
}

@code {
    [Parameter] public PrivateConversation Conversation { get; set; } = default!;

    private string CurrentMessage = "";
    private ElementReference MessagesDiv;
    private Action<PrivateMessageReceivedEvent>? _messageHandler;

    protected override void OnInitialized()
    {
        _messageHandler = HandleNewMessage;
        EventBus.Subscribe<PrivateMessageReceivedEvent>(_messageHandler);
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private async void HandleNewMessage(PrivateMessageReceivedEvent evt)
    {
        if (!evt.Sender.Nick.Equals(Conversation.User.Nick, StringComparison.OrdinalIgnoreCase))
            return;

        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Delay(50);
            await ScrollToBottom();
        });
    }

    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("scrollToBottom", MessagesDiv);
    }

    private async Task SendMessage()
    {
        if (!Common.IsConnected || string.IsNullOrWhiteSpace(CurrentMessage))
            return;

        await Common.ircClient.SendMessageAsync(Conversation.User.Nick, CurrentMessage);
        Conversation.Messages.Add(new ChatMessage(
            DateTime.UtcNow,
            new IrcUser(Common.ircClient.Nick),
            Conversation.User.Nick,
            CurrentMessage,
            false));
        CurrentMessage = "";
        await ScrollToBottom();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ScrollToBottom();
    }

    public void Dispose()
    {
        if (_messageHandler != null)
            EventBus.Unsubscribe<PrivateMessageReceivedEvent>(_messageHandler);
    }
}
