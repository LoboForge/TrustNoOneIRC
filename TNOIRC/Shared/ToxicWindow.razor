@using LoboForge.TNOIRC.Models
@using LoboForge.TNOIRC.Services
@using LoboForge.TNOIRC.Shared
@implements IDisposable
@inject ToxicService Toxic
@inject IJSRuntime JSRuntime

<div class="chat-window-content d-flex flex-column">
    <div class="chat-messages flex-grow-1 overflow-auto" @ref="MessagesDiv">
        @foreach (var msg in ToxMessages)
        {
            <div class="chat-message">
                <span class="timestamp">[@msg.Timestamp.ToShortTimeString()]</span>
                <span class="user">@msg.Sender.Nick:</span>
                <span class="text">
                    @foreach (var line in msg.Content.Split(new[] { "\r\n", "\n", "\r" }, StringSplitOptions.None))
                    {
                        @line
                        <br />
                    }
                </span>
            </div>
        }
    </div>

    <div style="position:absolute; bottom:50px; left:10px; width:90%; background-color:transparent;">
        <button @onclick="ToggleSystemMessages">⚙️</button>
    </div>

    <div class="chat-input mt-1">
        <input type="text"
               @bind-value="CurrentMessage"
               @bind-value:event="oninput"
               @onkeydown="HandleKey"
               placeholder="Type your message..." />
        <button @onclick="SendToxMessage">Send</button>
    </div>
</div>

@code {
    private string CurrentMessage = "";
    private ElementReference MessagesDiv;
    private List<ChatMessage> ToxMessages = new();
    private bool ShowSystemMessages = true;
    private Action<string>? _outputHandler;

    protected override void OnInitialized()
    {
        _outputHandler = HandleToxOutput;
        Toxic.OnOutput += _outputHandler;
        Toxic.Start();
    }

    private void HandleToxOutput(string line)
    {
        if (!ShowSystemMessages && line.StartsWith("["))
            return;

        var msg = new ChatMessage(
            DateTime.UtcNow,
            new IrcUser("TOX", "", ""),
            "TOX",
            line,
            false);

        InvokeAsync(async () =>
        {
            ToxMessages.Add(msg);
            StateHasChanged();
            await ScrollToBottom();
        });
    }

    private void SendToxMessage()
    {
        if (!string.IsNullOrWhiteSpace(CurrentMessage))
        {
            Toxic.SendCommand(CurrentMessage);
            CurrentMessage = "";
        }
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SendToxMessage();
    }

    private void ToggleSystemMessages()
    {
        ShowSystemMessages = !ShowSystemMessages;
    }

    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("scrollToBottom", MessagesDiv);
    }

    public void Dispose()
    {
        if (_outputHandler != null)
            Toxic.OnOutput -= _outputHandler;
    }
}
