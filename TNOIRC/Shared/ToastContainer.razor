@inject ToastService ToastService
@implements IDisposable

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    @foreach (var toast in toasts)
    {
        <div class="toast show mb-2 alert alert-@toast.Level.ToString().ToLower()">
            @toast.Message
        </div>
    }
</div>

@code {
    private List<ToastMessage> toasts = new();
    private Action<ToastMessage>? _showHandler;

    protected override void OnInitialized()
    {
        _showHandler = ShowToast;
        ToastService.OnShow += _showHandler;
    }

    private void ShowToast(ToastMessage toast)
    {
        toasts.Add(toast);
        InvokeAsync(StateHasChanged);
        _ = DismissAfterDelay(toast);
    }

    private async Task DismissAfterDelay(ToastMessage toast)
    {
        await Task.Delay(8000);
        toasts.Remove(toast);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_showHandler != null)
            ToastService.OnShow -= _showHandler;
    }
}
