{
  "executable": "LoboForge.TNOIRC",
  "splashscreen": {
    "imageFile": ""
  },
  "name": "LoboForge.TNOIRC",
  "author": "LoboForge <dev@loboforge.com>",
  "description": "Trust No One IRC Client by LoboForge.com",
  "singleInstance": false,
  "environment": "Development",
  "linux": {
    "maintainer": "LoboForge <dev@loboforge.com>",
    "icon": "/media/loboforge/Data/Development/TrustNoOneIRC/TNOIRC/appicon.png",
    "category": "Network"
  },
  "build": {
    "appId": "com.LoboForge.TNOIRC.app",
    "productName": "LoboForge.TNOIRC",
    "icon": "/media/loboforge/Data/Development/TrustNoOneIRC/TNOIRC/appicon.png",
    "copyright": "Copyright © 2024 LoboForge",
    "buildVersion": "1.0.0",
    "compression": "maximum",
    "directories": {
      "output": "../../../bin/Desktop"
    },
    "extraResources": [
      {
        "from": "./bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.ico",
      "category": "Network",
      "maintainer": "LoboForge <dev@loboforge.com>"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/256x256.png"
    },
    "files": [
      {
        "from": "./node_modules",
        "to": "node_modules",
        "filter": ["**/*"]
      },
      "**/*"
    ]
  }
}
